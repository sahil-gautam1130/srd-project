# Copy to .env and fill in. NEVER commit .env
PORT=3000
NODE_ENV=development

# Long random strings: run  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
OTP_SECRET=
ADMIN_PASSWORD=
# Random string used to hash Aadhaar numbers (keep it secret; changing it invalidates registered users)
ID_SALT=

# SMS provider: console (prints OTP in server log, for testing) | msg91 | fast2sms | twilio
SMS_PROVIDER=console

# MSG91
MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=
# Fast2SMS
FAST2SMS_KEY=
# Twilio
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# Razorpay (dashboard.razorpay.com > Settings > API Keys). Use rzp_test_ keys first.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: on first run, create demo Aadhaar users 123456789012 (BPL) and 987654321098 (APL) using YOUR mobile number
DEMO_MOBILE=
